# ── Nigehbaan environment configuration ─────────────────────────────
# Copy to .env and fill in real values. Never commit .env.

# Secret used to sign JWT session tokens (HS256).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated list of allowed CORS origins.
# Local dev: http://localhost:8000,http://localhost:5173
CORS_ORIGINS=http://localhost:8000

# Database URL. SQLite (dev) or PostgreSQL (production).
# Postgres example: postgresql+psycopg2://nigehbaan:pass@db:5432/nigehbaan
DATABASE_URL=sqlite:///./nigehbaan.db

# JWT session lifetime in minutes (default 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Argon2id parameters used to derive the Master Encryption Key (MEK)
# from the user's master password. Higher = slower = safer.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Rate limiting (requests per minute per route)
RATE_LIMIT_PER_MINUTE=30
